{
  "manifest_version": 3,
  "name": "Pagerunner",
  "version": "0.1.0",
  "description": "AI-powered browser agent — type a goal, watch it browse",
  "permissions": ["nativeMessaging", "activeTab", "tabs", "sidePanel"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
