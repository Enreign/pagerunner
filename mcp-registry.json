{
  "name": "pagerunner",
  "title": "Pagerunner \u2014 The Browser Layer That Learns",
  "version": "0.8.0",
  "description": "Real Chrome profiles with site intelligence \u2014 already logged in, PII anonymization, sessions persist",
  "author": {
    "name": "Enreign",
    "email": "contact@enreign.io"
  },
  "repository": "https://github.com/Enreign/pagerunner",
  "license": "MIT",
  "homepage": "https://github.com/Enreign/pagerunner",
  "bugs": "https://github.com/Enreign/pagerunner/issues",
  "keywords": [
    "mcp",
    "browser-automation",
    "chrome",
    "cdp",
    "web-scraping",
    "ai-agents",
    "automation",
    "site-intelligence",
    "session-persistence"
  ],
  "categories": [
    "browser-automation",
    "web-scraping",
    "data-extraction"
  ],
  "mcp": {
    "version": "1.0",
    "transport": "stdio",
    "tools": 46,
    "features": [
      "session-persistence",
      "site-intelligence",
      "anonymization",
      "auto-checkpoints",
      "snapshots",
      "stealth-mode",
      "audit-logging",
      "kv-store",
      "network-log",
      "console-log",
      "macos-menu-bar",
      "video-recording"
    ]
  },
  "installation": {
    "methods": [
      {
        "method": "homebrew",
        "command": "brew tap enreign/pagerunner && brew install pagerunner"
      },
      {
        "method": "npm",
        "command": "npx pagerunner"
      },
      {
        "method": "binary",
        "description": "Download pre-built binary from GitHub releases",
        "platforms": [
          {
            "os": "macos",
            "arch": "arm64",
            "url": "https://github.com/Enreign/pagerunner/releases/download/v0.8.0/pagerunner-macos-arm64"
          },
          {
            "os": "macos",
            "arch": "x86_64",
            "url": "https://github.com/Enreign/pagerunner/releases/download/v0.8.0/pagerunner-macos-x86_64"
          },
          {
            "os": "linux",
            "arch": "x86_64",
            "url": "https://github.com/Enreign/pagerunner/releases/download/v0.8.0/pagerunner-linux-x86_64"
          }
        ]
      },
      {
        "method": "cargo",
        "command": "cargo install --git https://github.com/Enreign/pagerunner"
      }
    ]
  },
  "setup": {
    "preRequisites": [
      "Chrome or Chromium browser installed",
      "Chrome profile directory accessible (not locked by browser)"
    ],
    "steps": [
      "pagerunner init",
      "claude mcp add pagerunner $(which pagerunner) mcp"
    ]
  },
  "documentation": {
    "readme": "https://github.com/Enreign/pagerunner#readme",
    "wiki": "https://github.com/Enreign/pagerunner/wiki",
    "setup": "https://github.com/Enreign/pagerunner/wiki/Installation",
    "tools": "https://github.com/Enreign/pagerunner/wiki/MCP-Tools-Reference",
    "security": "https://github.com/Enreign/pagerunner/wiki/Security"
  },
  "capabilities": {
    "sessionPersistence": [
      "Chrome survives daemon restarts (TCP-only CDP)",
      "Auto-checkpoint on close and every 5 minutes",
      "Automatic session reattach on daemon startup",
      "Configurable retention (snapshots, site knowledge TTL)"
    ],
    "siteIntelligence": [
      "JS adapters for direct API calls (bypass DOM)",
      "Auth token detection and vault storage",
      "Selector stability tracking with fragility warnings",
      "AI-powered adapter generation via Claude API"
    ],
    "sessionManagement": [
      "Multiple concurrent browser sessions",
      "Chrome profile persistence with real cookies/passwords",
      "Daemon mode for shared state across MCP clients",
      "Session checkpoints (save/restore full tab state)"
    ],
    "browserControl": [
      "Tab management (new, list, close)",
      "Navigation with URL and selector-based wait conditions",
      "JavaScript evaluation",
      "Stealth mode to mask automation signals"
    ],
    "contentExtraction": [
      "Sanitized page text content",
      "Full-page screenshots (PNG)",
      "Network request log",
      "Console output capture"
    ],
    "security": [
      "PII anonymization (tokenize or redact, 6+ entity types + NER)",
      "SSRF protection, domain allowlisting",
      "Prompt injection sanitization",
      "Append-only audit logging",
      "Encrypted state database"
    ]
  },
  "testing": {
    "unitTests": "407 passing",
    "cliIntegration": "82 passing (81 on macOS, 1 ignored)",
    "liveTests": "65 scenarios documented"
  },
  "releaseNotes": {
    "v0.6.0": "https://github.com/Enreign/pagerunner/releases/tag/v0.6.0",
    "v0.5.0": "https://github.com/Enreign/pagerunner/releases/tag/v0.5.0",
    "v0.4.0": "https://github.com/Enreign/pagerunner/releases/tag/v0.4.0",
    "v0.6.1": "https://github.com/Enreign/pagerunner/releases/tag/v0.6.1",
    "v0.7.0": "https://github.com/Enreign/pagerunner/releases/tag/v0.7.0",
    "v0.7.1": "https://github.com/Enreign/pagerunner/releases/tag/v0.7.1",
    "v0.8.0": "https://github.com/Enreign/pagerunner/releases/tag/v0.8.0"
  }
}
